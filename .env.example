# CODE SPRINT — environment configuration (copy to .env and edit)
# Port the server listens on (default 3000)
PORT=3000

# Path to the SQLite database file (default: ./codesprint.db in this folder)
# CODESPRINT_DB=D:\codesprint\codesprint.db

# Team session lifetime in hours (default 12 — covers a one-day event)
SESSION_TTL_HOURS=12

# NOTE: passwords are NOT set here. Admin/judge passwords are set via seed.js:
#   node seed.js --admin-pass <strong-password> --judge-pass <strong-password>
# Team passwords default to sprint01..sprintNN and MUST be changed before the event
# (see README "Provisioning accounts").
